{
    // 使用 IntelliSense 了解相关属性。 
    // 悬停以查看现有属性的描述。
    // 欲了解更多信息，请访问: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) qwq 启动perf_analyzer",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/perf_analyzer/src/perf-analyzer-build/perf_analyzer",
            "args":["-m","qwq","--async","--stability-percentage","999","--warmup-request-count","0","--request-count","10","-i","http","--service-kind","openai","common.py:188","--endpoint","v1/completions","--input-data","artifacts/qwq-openai-completions-concurrency1/inputs.json","--profile-export-file","artifacts/qwq-openai-completions-concurrency1/profile_export.json","-v","-v","-u","http://192.168.81.18:11436"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "为 gdb 启用整齐打印",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "将反汇编风格设置为 Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        },



        {
            "name": "Python 调试程序: 包含参数的当前文件",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": "${command:pickArgs}"
        },
        {
            "name": "81.18 ollama qwq profile",
            "type": "debugpy",
            "request": "launch",
            "module": "genai_perf.main",
            "console": "integratedTerminal",
            "args": "profile -m qwq  --service-kind openai   --endpoint-type completions   --url http://192.168.81.18:11436 -v --tokenizer=Qwen/QwQ-32B",
            "cwd": "${workspaceFolder}/genai-perf",
            "justMyCode": false
        }

          
    ]
}